# Пример файла переменных окружения для docker compose.
# Скопируйте в .env:  cp .env.example .env
# Docker Compose подхватывает .env автоматически — править docker-compose.yml не нужно.

# --- Параметры PostgreSQL ---
POSTGRES_DB=training_courses
POSTGRES_USER=training_user
POSTGRES_PASSWORD=training_password

# Порт БД на хосте. Внутри compose-сети БД всегда слушает 5432.
# 55432 выбран, потому что 5432 на машине разработчика обычно занят локальным PostgreSQL.
POSTGRES_HOST_PORT=55432

# --- Параметры API ---
API_HOST_PORT=8080

# Загрузить демонстрационные курсы при первом запуске (true/false).
SEED_ON_STARTUP=false